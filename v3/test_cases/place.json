{
  "name": "Place endpoint",
  "description": "Verify place endpoint",
  "tests": [
    {
      "id": "gosp",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "NSR:GroupOfStopPlaces:1,NSR:GroupOfStopPlaces:10"
      },
      "expected": {
        "priorityThresh": 2,
        "coordinates": [[10.748128, 59.911076]],
        "properties": [
          {
            "id": "NSR:GroupOfStopPlaces:1",
            "layer": "groupOfStopPlaces",
            "names": {
              "default": "Oslo",
              "display": "Oslo, Oslo"
            }
          },
          {
            "id": "NSR:GroupOfStopPlaces:10"
          }
        ]
      }
    },
    {
      "id": "openaddresses",
      "description": "Verify matrikkel lookup. NOTE: v3 extra.id stores the full prefixed ID",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "KVE:PostalAddress:10855461"
      },
      "expected": {
        "priorityThresh": 1,
        "coordinates": [[9.664788, 59.320199]],
        "properties": [
          {
            "id": "KVE:PostalAddress:10855461",
            "layer": "address",
            "names": {
              "default": "Grorudveien 88",
              "display": "Grorudveien 88, Siljan"
            },
            "address": {
              "streetName": "Grorudveien",
              "houseNumber": "88",
              "postalCode": "3748",
              "borough": "Opdalen",
              "boroughId": "KVE:Borough:40100102",
              "localityId": "KVE:TopographicPlace:4010"
            }
          }
        ]
      }
    },
    {
      "id": "osm",
      "description": "Verify osm lookup. v3 uses OSM:TopographicPlace (same shape as v2)",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "OSM:TopographicPlace:545260792"
      },
      "expected": {
        "priorityThresh": 1,
        "properties": [
          {
            "id": "OSM:TopographicPlace:545260792"
          }
        ]
      }
    },
    {
      "id": "street-with-spaces",
      "description": "Street id lookup with spaces in the name (transliterated to Photon-safe category on both index and query side)",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "KVE:TopographicPlace:0301-Karl Johans gate"
      },
      "expected": {
        "priorityThresh": 1,
        "properties": [
          {
            "id": "KVE:TopographicPlace:0301-Karl Johans gate"
          }
        ]
      }
    },
    {
      "id": "street-with-diacritics",
      "description": "Street id lookup with Norwegian characters (ø -> oe transliteration must match between converter and proxy)",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "KVE:TopographicPlace:3407-Fahlstrøms plass"
      },
      "expected": {
        "priorityThresh": 1,
        "properties": [
          {
            "id": "KVE:TopographicPlace:3407-Fahlstrøms plass"
          }
        ]
      }
    }
  ]
}
