{
  "name": "Edge cases",
  "description": "Results that required some tweaks",
  "tests": [
    {
      "id": "kaia kafe",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "kaia kafe"
      },
      "expected": {
        "priorityThresh": 3,
        "properties": [
          {
            "address": {
              "county": "Nordland",
              "countyId": "KVE:TopographicPlace:18",
              "locality": "Narvik",
              "localityId": "KVE:TopographicPlace:1806"
            }
          }
        ]
      }
    },
    {
      "id": "grünerløkka",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "grünerløkka"
      },
      "expected": {
        "priorityThresh": 3,
        "properties": [
          {
            "categories": ["tettbebyggelse"]
          }
        ]
      }
    },
    {
      "id": "gardermoen-popular-name",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "gardermoen"
      },
      "expected": {
        "priorityThresh": 1,
        "properties": [
          {
            "id": "NSR:StopPlace:58211",
            "names": {
              "default": "Oslo lufthavn",
              "label": "Gardermoen"
            }
          }
        ]
      }
    },
    {
      "id": "lærdal-rådhus-no-popular-name",
