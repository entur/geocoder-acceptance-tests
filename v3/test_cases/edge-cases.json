    {
      "id": "reverse-layers-filter",
      "endpoint": "reverse",
      "status": "pass",
      "in": {
        "lat": 60.060936,
        "lon": 10.309086,
        "layers": "stopPlace",
        "limit": 50,
        "radius": 2.5
      },
      "unexpected": {
        "priorityThresh": 1,
        "properties": [
          {
            "layer": "address"
          }
        ]
      }
    },
    {
      "id": "only-stopplaces-and-gosp",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "oslo",
        "layers": "stopPlace,groupOfStopPlaces",
        "limit": 10
      },
      "expected": {
        "priorityThresh": 10,
        "properties": [
          {
            "id": "NSR:GroupOfStopPlaces:1",
            "layer": "groupOfStopPlaces"
          },
          {
            "id": "NSR:StopPlace:59872",
            "layer": "stopPlace"
          }
        ]
      },
      "unexpected": {
        "priorityThresh": 10,
        "properties": [
          { "layer": "poi" },
          { "layer": "address" },
          { "layer": "street" },
          { "layer": "place" }
        ]
      }
    },
    {
      "id": "layers-and-stopplacetypes-union",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "oslo",
        "layers": "stopPlace,groupOfStopPlaces",
        "stopPlaceTypes": "railStation",
        "limit": 10
      },
      "expected": {
        "priorityThresh": 10,
        "properties": [
          { "id": "NSR:GroupOfStopPlaces:1", "layer": "groupOfStopPlaces" },
          { "id": "NSR:StopPlace:59872", "layer": "stopPlace" }
        ]
      },
      "unexpected": {
        "priorityThresh": 10,
        "properties": [
          { "layer": "poi" },
          { "layer": "address" },
          { "layer": "street" },
          { "layer": "place" }
        ]
      }
    },
    {
      "id": "stopplacetypes-still-constrains-stopplace-layer-in-union",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "oslo",
        "layers": "stopPlace,groupOfStopPlaces",
        "stopPlaceTypes": "airport",
        "limit": 10
      },
      "expected": {
        "priorityThresh": 10,
        "properties": [
          { "id": "NSR:GroupOfStopPlaces:1", "layer": "groupOfStopPlaces" }
        ]
      },
      "unexpected": {
        "priorityThresh": 10,
        "properties": [{ "id": "NSR:StopPlace:59872" }]
      }
    },
