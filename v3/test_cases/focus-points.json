{
  "name": "Focus points",
  "description": "Find closest commonly used name from country edges",
  "tests": [
    {
      "id": "haugen1",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "haugen",
        "lat": 57.98,
        "lon": 7.04
      },
      "expected": {
        "priorityThresh": 5,
        "properties": [
          {
            "id": "KVE:TopographicPlace:4205-Haugen"
          }
        ]
      }
    },
    {
      "id": "haugen2",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "haugen",
        "lat": 70.38,
        "lon": 31.15
      },
      "expected": {
        "priorityThresh": 3,
        "properties": [
          {
            "id": "KVE:TopographicPlace:5620-Haugen"
          }
        ]
      }
    },
    {
      "id": "haugen3",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "haugen",
        "lat": 65,
        "lon": 12.6
      },
      "expected": {
        "priorityThresh": 3,
        "properties": [
          {
            "id": "NSR:StopPlace:46483"
          }
        ]
      }
    },
    {
      "id": "os",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "os",
        "lat": 59.9113,
        "lon": 10.74161,
        "limit": 30
      },
      "expected": {
        "priorityThresh": 15,
        "properties": [
          {
            "id": "NSR:StopPlace:2479"
          },
          {
            "id": "NSR:StopPlace:57545"
          }
        ]
      }
    },
    {
      "id": "bussterminal-nearest-first",
      "description": "bias is flat inside the focus radius, so a too-wide radius let Lillestrøm (17 km) outrank Sandvika (12.8 km)",
      "endpoint": "autocomplete",
      "status": "pass",
      "in": {
        "q": "bussterminal",
        "lat": 59.9114,
        "lon": 10.75105,
        "limit": 10
      },
      "expected": {
        "priorityThresh": 2,
        "properties": [
          {
            "id": "NSR:StopPlace:58293"
          },
          {
            "id": "NSR:StopPlace:4030"
          }
        ]
      }
    }
  ]
}
