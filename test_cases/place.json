{
  "name": "Place endpoint",
  "description": "Verify place endpoint",
  "tests": [
    {
      "id": "gosp",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "whosonfirst:address:NSR:GroupOfStopPlaces:1,whosonfirst:address:NSR:GroupOfStopPlaces:10"
      },
      "expected": {
        "priorityThresh": 2,
        "coordinates": [[10.748128, 59.911076]],
        "properties": [
          {
            "id": "NSR:GroupOfStopPlaces:1",
            "name": "Oslo",
            "label": "Oslo"
          },
          {
            "id": "NSR:GroupOfStopPlaces:10"
          }
        ]
      }
    },
    {
      "id": "openaddresses",
      "description": "Verify matrikkel lookup",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "openaddresses:address:10855461"
      },
      "expected": {
        "priorityThresh": 1,
        "coordinates": [[9.664788, 59.320199]],
        "properties": [
          {
            "id": "10855461",
            "layer": "address",
            "name": "Grorudveien 88",
            "street": "Grorudveien",
            "housenumber": "88",
            "postalcode": "3748"
          }
        ]
      }
    },
    {
      "id": "osm",
      "description": "Verify osm lookup",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "OSM:TopographicPlace:545260792"
      },
      "expected": {
        "priorityThresh": 1,
        "properties": [
          {
            "id": "OSM:TopographicPlace:545260792"
          }
        ]
      }
    },
    {
      "id": "street-with-spaces",
      "description": "Street id lookup with spaces in the name (transliterated to Photon-safe category on both index and query side)",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "KVE:TopographicPlace:0301-Karl Johans gate"
      },
      "expected": {
        "priorityThresh": 1,
        "properties": [
          {
            "id": "KVE:TopographicPlace:0301-Karl Johans gate"
          }
        ]
      }
    },
    {
      "id": "street-with-diacritics",
      "description": "Street id lookup with Norwegian characters (oe transliteration must match between converter and proxy)",
      "endpoint": "place",
      "status": "pass",
      "in": {
        "ids": "KVE:TopographicPlace:3407-Fahlstrøms plass"
      },
      "expected": {
        "priorityThresh": 1,
        "properties": [
          {
            "id": "KVE:TopographicPlace:3407-Fahlstrøms plass"
          }
        ]
      }
    }
  ]
}
